{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JobEvent",
  "description": "One append-only lifecycle fact.",
  "type": "object",
  "required": [
    "causation_id",
    "detail",
    "event_id",
    "job_id",
    "kind",
    "lease_epoch",
    "schema_version",
    "sequence",
    "timestamp"
  ],
  "properties": {
    "causation_id": {
      "type": "string"
    },
    "detail": true,
    "event_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/definitions/JobEventKind"
    },
    "lease_epoch": {
      "description": "Epoch zero is reserved for trusted controller events before a lease is acquired. Worker control events require the current non-zero epoch.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "sequence": {
      "type": "integer",
      "format": "uint64",
      "minimum": 1.0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "JobEventKind": {
      "type": "string",
      "enum": [
        "created",
        "contract_approved",
        "queued",
        "lease_acquired",
        "lease_reclaimed",
        "child_launch_prepared",
        "attempt_started",
        "child_linked",
        "attempt_stopped",
        "retry_scheduled",
        "deterministic_gate_passed",
        "deterministic_gate_failed",
        "semantic_judge_achieved",
        "semantic_judge_revise",
        "semantic_judge_uncertain",
        "needs_review",
        "blocked",
        "budget_exhausted",
        "deadline_reached",
        "cancel_requested",
        "cancelled",
        "failed",
        "verified",
        "result_applied",
        "result_exported"
      ]
    }
  }
}
