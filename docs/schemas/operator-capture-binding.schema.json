{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OperatorCaptureBinding",
  "description": "Immutable identity approved before the first capture event.",
  "type": "object",
  "required": [
    "allowed_terminal_results",
    "capture_binary",
    "capture_binary_sha256",
    "created_at",
    "deadreckon_binary",
    "deadreckon_binary_sha256",
    "deadreckon_source_revision",
    "deadreckon_version",
    "declared_backend",
    "declared_shape",
    "job_id",
    "manifest_sha256",
    "pass_capable",
    "provider_routes",
    "recorder_interpreter",
    "recorder_interpreter_sha256",
    "recorder_sha256",
    "replay_sha256",
    "required_captures",
    "result_schema_sha256",
    "schema_version",
    "session_id",
    "signature",
    "source_revision",
    "source_tree_sha256",
    "trial_id"
  ],
  "properties": {
    "allowed_terminal_results": {
      "description": "Exact product terminal results approved before the fault is applied. A `verified/verified` result still requires a valid CompletionReceipt; every other accepted pair requires authenticated terminal-history lineage instead.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/OperatorCaptureExpectedJobResult"
      }
    },
    "capture_binary": {
      "type": "string"
    },
    "capture_binary_sha256": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadreckon_binary": {
      "type": "string"
    },
    "deadreckon_binary_sha256": {
      "type": "string"
    },
    "deadreckon_source_revision": {
      "type": "string"
    },
    "deadreckon_version": {
      "type": "string"
    },
    "declared_backend": {
      "type": "string"
    },
    "declared_shape": {
      "$ref": "#/definitions/JobShape"
    },
    "job_id": {
      "type": "string"
    },
    "manifest_sha256": {
      "type": "string"
    },
    "network_probe": {
      "description": "Exact registry-backed provider endpoint approved for the network-loss trial. Other trials must not carry a network probe authority.",
      "anyOf": [
        {
          "$ref": "#/definitions/OperatorCaptureNetworkProbe"
        },
        {
          "type": "null"
        }
      ]
    },
    "pass_capable": {
      "type": "boolean"
    },
    "provider_routes": {
      "description": "Approved provider routes keyed by manifest-declared execution role.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "recorder_interpreter": {
      "description": "Absolute interpreter route approved for deterministic recorder replay.",
      "type": "string"
    },
    "recorder_interpreter_sha256": {
      "type": "string"
    },
    "recorder_sha256": {
      "type": "string"
    },
    "replay_sha256": {
      "type": "string"
    },
    "required_captures": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/OperatorCaptureRequirement"
      }
    },
    "result_schema_sha256": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "session_id": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    },
    "source_revision": {
      "type": "string"
    },
    "source_tree_sha256": {
      "type": "string"
    },
    "trial_id": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "JobOutcome": {
      "description": "Terminal classification, separate from both phase and causal stop reason.",
      "type": "string",
      "enum": [
        "verified",
        "needs_review",
        "blocked",
        "budget_exhausted",
        "deadline_reached",
        "retry_exhausted",
        "cancelled",
        "failed"
      ]
    },
    "JobShape": {
      "type": "string",
      "enum": [
        "single",
        "graph",
        "legacy_chain",
        "legacy_campaign"
      ]
    },
    "OperatorCaptureExpectedJobResult": {
      "description": "One exact outcome/reason pair that may satisfy a dogfood trial.",
      "type": "object",
      "required": [
        "outcome",
        "stop_reason"
      ],
      "properties": {
        "outcome": {
          "$ref": "#/definitions/JobOutcome"
        },
        "stop_reason": {
          "$ref": "#/definitions/StopReason"
        }
      },
      "additionalProperties": false
    },
    "OperatorCaptureNetworkProbe": {
      "description": "Immutable provider route and endpoint selected before a network fault.",
      "type": "object",
      "required": [
        "endpoint",
        "provider_role",
        "provider_route"
      ],
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "provider_role": {
          "type": "string"
        },
        "provider_route": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "OperatorCapturePhase": {
      "description": "Operator-capture phase, kept separate from Job lifecycle state.",
      "type": "string",
      "enum": [
        "prepared",
        "before",
        "intervention",
        "after",
        "cleanup",
        "finalized"
      ]
    },
    "OperatorCaptureRequirement": {
      "type": "object",
      "required": [
        "media_type",
        "phase",
        "source",
        "subject"
      ],
      "properties": {
        "media_type": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/definitions/OperatorCapturePhase"
        },
        "source": {
          "$ref": "#/definitions/OperatorCaptureSource"
        },
        "subject": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "OperatorCaptureSource": {
      "description": "Closed source vocabulary. Only `ManualFile` accepts a caller-provided path.",
      "type": "string",
      "enum": [
        "binding",
        "job_view",
        "job_events",
        "job_intervention",
        "job_cleanup",
        "job",
        "authority",
        "launch_plan",
        "lease",
        "job_report",
        "receipt",
        "supervised_child",
        "host_boot_id",
        "semantic_judgment",
        "parent_repair_manifest",
        "parent_repair_candidate",
        "doctor",
        "supervisor_service_status",
        "parent_artifact",
        "parent_events",
        "campaign",
        "campaign_events",
        "active_plan",
        "active_plan_events",
        "network_connectivity_observation",
        "sandbox_boundary_observation",
        "campaign_intervention",
        "result_envelope",
        "manual_file",
        "unavailable_objective"
      ]
    },
    "StopReason": {
      "description": "Why execution stopped. New jobs persist this typed value instead of recovering meaning from free-form failure text.",
      "type": "string",
      "enum": [
        "verified",
        "semantic_revise",
        "semantic_uncertain",
        "semantic_unavailable",
        "operator_input_required",
        "spend_cap",
        "wall_cap",
        "deadline",
        "attempt_limit",
        "cancel_requested",
        "transient_provider",
        "fatal_provider",
        "fatal_gate",
        "lost_containment",
        "corrupt_history",
        "legacy_unknown"
      ]
    }
  }
}
