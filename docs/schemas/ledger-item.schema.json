{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LedgerItem",
  "description": "One in-memory vocabulary for every line kind persisted by a run.\n\nThe adjacent payload is used only when serializing the union itself. The per-file line wrappers below remain transparent and preserve today's bare JSONL shapes.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "event"
          ]
        },
        "value": {
          "$ref": "#/definitions/RunEvent"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "spend"
          ]
        },
        "value": {
          "$ref": "#/definitions/SpendRecord"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "trace"
          ]
        },
        "value": {
          "$ref": "#/definitions/TraceRecord"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "flight"
          ]
        },
        "value": {
          "$ref": "#/definitions/FlightEvent"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "narrative_snapshot_ref"
          ]
        },
        "value": {
          "$ref": "#/definitions/NarrativeSnapshotRef"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "unknown"
          ]
        }
      }
    }
  ],
  "definitions": {
    "FlightEvent": {
      "type": "object",
      "required": [
        "attempt",
        "deadreckon_turn",
        "flight_session_id",
        "kind",
        "provider",
        "raw_hash",
        "run_id",
        "schema",
        "seq",
        "source_event",
        "summary",
        "version"
      ],
      "properties": {
        "attempt": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "checkpoint_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "deadreckon_turn": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "files": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flight_session_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/FlightEventKind"
        },
        "provider": {
          "type": "string"
        },
        "raw_hash": {
          "type": "string"
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "source_event": {
          "type": "string"
        },
        "source_line": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "tool_category": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/definitions/FlightUsage"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "FlightEventKind": {
      "type": "string",
      "enum": [
        "agent",
        "thinking",
        "tool",
        "result",
        "todo",
        "tokens",
        "session",
        "checkpoint",
        "warning",
        "error"
      ]
    },
    "FlightUsage": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "context_window": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "NarrativeSnapshotRef": {
      "description": "A stable pointer to a narrative snapshot row. The snapshot body remains an application-local projection and is intentionally not part of the protocol.",
      "type": "object",
      "required": [
        "path",
        "snapshot_id"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "snapshot_id": {
          "type": "string"
        }
      }
    },
    "RunEvent": {
      "type": "object",
      "required": [
        "event",
        "run_id",
        "timestamp"
      ],
      "properties": {
        "event": {
          "$ref": "#/definitions/RunEventKind"
        },
        "run_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "RunEventKind": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "turn"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "turn_started"
              ]
            },
            "turn": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "args",
            "kind",
            "tool_call_id",
            "tool_name",
            "turn"
          ],
          "properties": {
            "args": true,
            "kind": {
              "type": "string",
              "enum": [
                "tool_call_started"
              ]
            },
            "tool_call_id": {
              "type": "string"
            },
            "tool_name": {
              "type": "string"
            },
            "turn": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "preview",
            "status",
            "tool_call_id",
            "turn"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "tool_call_result"
              ]
            },
            "preview": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "tool_call_id": {
              "type": "string"
            },
            "turn": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "input_tokens",
            "kind",
            "output_tokens",
            "turn"
          ],
          "properties": {
            "input_tokens": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "kind": {
              "type": "string",
              "enum": [
                "token_usage_delta"
              ]
            },
            "output_tokens": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "turn": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "cost_usd",
            "kind",
            "total_cost_usd",
            "turn"
          ],
          "properties": {
            "cost_usd": {
              "type": "number",
              "format": "double"
            },
            "kind": {
              "type": "string",
              "enum": [
                "spend_delta"
              ]
            },
            "total_cost_usd": {
              "type": "number",
              "format": "double"
            },
            "turn": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "wall_time_seconds": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "path",
            "status",
            "turn"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "docs_checkpoint"
              ]
            },
            "path": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "turn": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          }
        },
        {
          "description": "A queued steer-inbox entry was consumed and delivered to the run: the turn loop injected it into turn `turn`'s prompt frame as advisory operator guidance (between-turn delivery, any provider). `queued_at` is the durable inbox timestamp, so a consumer can render queued→ack.",
          "type": "object",
          "required": [
            "kind",
            "preview",
            "queued_at",
            "source",
            "turn"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "steer_delivered"
              ]
            },
            "preview": {
              "type": "string"
            },
            "queued_at": {
              "type": "string",
              "format": "date-time"
            },
            "source": {
              "type": "string"
            },
            "turn": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "status"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "run_completed"
              ]
            },
            "status": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "library_dir"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "run_promoted"
              ]
            },
            "library_dir": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "message"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "error"
              ]
            },
            "message": {
              "type": "string"
            },
            "turn": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            }
          }
        }
      ]
    },
    "SpendRecord": {
      "type": "object",
      "required": [
        "cost_usd",
        "input_tokens",
        "model",
        "output_tokens",
        "provider",
        "timestamp",
        "total_cost_usd",
        "turn"
      ],
      "properties": {
        "cap_usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "cost_usd": {
          "type": "number",
          "format": "double"
        },
        "estimated": {
          "default": false,
          "type": "boolean"
        },
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "kind": {
          "description": "`\"loop\"` for the run loop's own turns, `\"narrator\"` for live-narration calls. Defaulted so legacy spend.jsonl rows still parse.",
          "default": "loop",
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "provider": {
          "type": "string"
        },
        "subscription": {
          "default": false,
          "type": "boolean"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "total_cost_usd": {
          "type": "number",
          "format": "double"
        },
        "turn": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "wall_time_cap_seconds": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "wall_time_seconds": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "TraceRecord": {
      "type": "object",
      "required": [
        "detail",
        "event",
        "run_id",
        "timestamp",
        "turn"
      ],
      "properties": {
        "detail": true,
        "event": {
          "type": "string"
        },
        "latency_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint128",
          "minimum": 0.0
        },
        "run_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "turn": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    }
  }
}
