{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CompletionReceipt",
  "description": "Cryptographically authenticated two-key completion result persisted in `receipt.json`.",
  "type": "object",
  "required": [
    "attempt",
    "authority_sha256",
    "contained",
    "contract_sha256",
    "deterministic_marker_sha256",
    "effective_policy_sha256",
    "goal_sha256",
    "issued_at",
    "issuer",
    "job_id",
    "launch_plan_sha256",
    "outcome",
    "outer_launch_id",
    "proof_kind",
    "result_tree_sha256",
    "run_id",
    "sandbox_backend",
    "sandbox_boundary_observation_sha256",
    "schema_version",
    "semantic_judgment_sha256",
    "signature",
    "source_tree_sha256",
    "stop_reason"
  ],
  "properties": {
    "attempt": {
      "description": "Durable Job attempt whose contained gate produced this result.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "authority_sha256": {
      "type": "string"
    },
    "contained": {
      "type": "boolean"
    },
    "contract_sha256": {
      "type": "string"
    },
    "deterministic_marker_sha256": {
      "type": "string"
    },
    "effective_policy_sha256": {
      "type": "string"
    },
    "execution_evidence": {
      "anyOf": [
        {
          "$ref": "#/definitions/CompletionExecutionEvidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "goal_sha256": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "$ref": "#/definitions/CompletionReceiptIssuer"
    },
    "job_id": {
      "type": "string"
    },
    "launch_plan_sha256": {
      "type": "string"
    },
    "outcome": {
      "$ref": "#/definitions/JobOutcome"
    },
    "outer_launch_id": {
      "description": "Exact supervisor child launch that owned the contained gate.",
      "type": "string"
    },
    "proof_kind": {
      "$ref": "#/definitions/CompletionProofKind"
    },
    "result_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "result_tree_sha256": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "sandbox_backend": {
      "type": "string"
    },
    "sandbox_boundary_observation_sha256": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "semantic_judgment_sha256": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    },
    "source_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_tree_sha256": {
      "type": "string"
    },
    "stop_reason": {
      "$ref": "#/definitions/StopReason"
    }
  },
  "definitions": {
    "CompletionExecutionEvidence": {
      "description": "Exact controller-owned execution ledgers covered by a verified receipt. Present for durable ordered chains, whose final tree alone cannot explain which approved hooks ran or which child result was landed at each step.",
      "type": "object",
      "required": [
        "ordered_candidate_manifest_sha256"
      ],
      "properties": {
        "candidate_application_events_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "chain_hook_events_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "ordered_candidate_manifest_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "CompletionProofKind": {
      "type": "string",
      "enum": [
        "two_key_completion"
      ]
    },
    "CompletionReceiptIssuer": {
      "type": "string",
      "enum": [
        "deadreckon-supervisor"
      ]
    },
    "JobOutcome": {
      "description": "Terminal classification, separate from both phase and causal stop reason.",
      "type": "string",
      "enum": [
        "verified",
        "needs_review",
        "blocked",
        "budget_exhausted",
        "deadline_reached",
        "retry_exhausted",
        "cancelled",
        "failed"
      ]
    },
    "StopReason": {
      "description": "Why execution stopped. New jobs persist this typed value instead of recovering meaning from free-form failure text.",
      "type": "string",
      "enum": [
        "verified",
        "semantic_revise",
        "semantic_uncertain",
        "semantic_unavailable",
        "operator_input_required",
        "spend_cap",
        "wall_cap",
        "deadline",
        "attempt_limit",
        "cancel_requested",
        "deterministic_revise",
        "transient_provider",
        "fatal_provider",
        "fatal_gate",
        "lost_containment",
        "supervisor_failure",
        "corrupt_history",
        "legacy_unknown"
      ]
    }
  }
}
