{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Job",
  "description": "Immutable identity and approved policy persisted in `job.json`.",
  "type": "object",
  "required": [
    "authority_sha256",
    "created_at",
    "goal",
    "job_id",
    "launch_plan_sha256",
    "policy",
    "schema_version",
    "scope",
    "shape",
    "source_cwd"
  ],
  "properties": {
    "authority_sha256": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "goal": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "launch_plan_sha256": {
      "type": "string"
    },
    "policy": {
      "$ref": "#/definitions/JobPolicy"
    },
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "scope": {
      "type": "string"
    },
    "shape": {
      "$ref": "#/definitions/JobShape"
    },
    "source_cwd": {
      "type": "string"
    }
  },
  "definitions": {
    "DockerGateIdentity": {
      "description": "Immutable Docker execution identity for a Linux gate evaluator.",
      "type": "object",
      "required": [
        "guest_path",
        "image_id",
        "platform"
      ],
      "properties": {
        "guest_path": {
          "description": "Fixed absolute path of the evaluator inside the immutable image.",
          "type": "string"
        },
        "image_id": {
          "description": "Content-addressed Docker image ID, never a mutable tag.",
          "type": "string"
        },
        "platform": {
          "description": "Explicit Docker platform in `<os>/<architecture>` form.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "GateBinaryIdentity": {
      "description": "Content identity of one trusted `dr-gate` executable.",
      "type": "object",
      "required": [
        "arch",
        "os",
        "sha256"
      ],
      "properties": {
        "arch": {
          "description": "Architecture expected by the executable, for example `aarch64` or `x86_64`.",
          "type": "string"
        },
        "os": {
          "description": "Operating system expected by the executable, for example `macos` or `linux`.",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 of the exact executable bytes.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "GateEvaluatorIdentity": {
      "description": "Versioned controller/evaluator identity approved for one durable Job.",
      "type": "object",
      "required": [
        "controller",
        "evaluator",
        "protocol_version",
        "schema_version"
      ],
      "properties": {
        "controller": {
          "description": "Host-compatible binary used for guarded release and trusted signing.",
          "allOf": [
            {
              "$ref": "#/definitions/GateBinaryIdentity"
            }
          ]
        },
        "docker": {
          "description": "Required for Docker evaluation and absent for native containment.",
          "anyOf": [
            {
              "$ref": "#/definitions/DockerGateIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "evaluator": {
          "description": "Binary that executes deterministic checks inside containment.",
          "allOf": [
            {
              "$ref": "#/definitions/GateBinaryIdentity"
            }
          ]
        },
        "protocol_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "JobExecutionPolicy": {
      "type": "object",
      "required": [
        "require_containment",
        "sandbox_requested",
        "tools"
      ],
      "properties": {
        "gate_evaluator": {
          "description": "Exact controller/evaluator toolchain approved before the first turn.\n\n`None` keeps pre-identity Jobs readable. A new strict Job must persist this field together with matching authority and boundary-observation digests; partial identity state fails closed during verification.",
          "anyOf": [
            {
              "$ref": "#/definitions/GateEvaluatorIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "require_containment": {
          "type": "boolean"
        },
        "sandbox_requested": {
          "type": "string"
        },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/JobToolPolicy"
          }
        }
      }
    },
    "JobPolicy": {
      "type": "object",
      "required": [
        "max_attempts",
        "max_spend_usd",
        "max_wall_seconds",
        "semantic_judge"
      ],
      "properties": {
        "deadline": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "execution": {
          "description": "Resolved provider capability policy approved before the first turn.\n\n`None` is retained only for reading pre-Watchkeeper-policy jobs.",
          "anyOf": [
            {
              "$ref": "#/definitions/JobExecutionPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_attempts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "max_spend_usd": {
          "type": "number",
          "format": "double"
        },
        "max_wall_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "semantic_judge": {
          "$ref": "#/definitions/SemanticJudgeMode"
        }
      }
    },
    "JobShape": {
      "type": "string",
      "enum": [
        "single",
        "graph",
        "legacy_chain",
        "legacy_campaign"
      ]
    },
    "JobToolPolicy": {
      "type": "object",
      "required": [
        "workspace_read",
        "workspace_write"
      ],
      "properties": {
        "network_allowlist": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workspace_read": {
          "type": "boolean"
        },
        "workspace_write": {
          "type": "boolean"
        }
      }
    },
    "SemanticJudgeMode": {
      "type": "string",
      "enum": [
        "required",
        "optional",
        "disabled"
      ]
    }
  }
}
