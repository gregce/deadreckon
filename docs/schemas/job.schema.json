{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Job",
  "description": "Immutable identity and approved policy persisted in `job.json`.",
  "type": "object",
  "required": [
    "authority_sha256",
    "created_at",
    "goal",
    "job_id",
    "launch_plan_sha256",
    "policy",
    "schema_version",
    "scope",
    "shape",
    "source_cwd"
  ],
  "properties": {
    "authority_sha256": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "goal": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "launch_plan_sha256": {
      "type": "string"
    },
    "policy": {
      "$ref": "#/definitions/JobPolicy"
    },
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "scope": {
      "type": "string"
    },
    "shape": {
      "$ref": "#/definitions/JobShape"
    },
    "source_cwd": {
      "type": "string"
    }
  },
  "definitions": {
    "JobExecutionPolicy": {
      "type": "object",
      "required": [
        "require_containment",
        "sandbox_requested",
        "tools"
      ],
      "properties": {
        "require_containment": {
          "type": "boolean"
        },
        "sandbox_requested": {
          "type": "string"
        },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/JobToolPolicy"
          }
        }
      }
    },
    "JobPolicy": {
      "type": "object",
      "required": [
        "max_attempts",
        "max_spend_usd",
        "max_wall_seconds",
        "semantic_judge"
      ],
      "properties": {
        "deadline": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "execution": {
          "description": "Resolved provider capability policy approved before the first turn.\n\n`None` is retained only for reading pre-Watchkeeper-policy jobs.",
          "anyOf": [
            {
              "$ref": "#/definitions/JobExecutionPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_attempts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "max_spend_usd": {
          "type": "number",
          "format": "double"
        },
        "max_wall_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "semantic_judge": {
          "$ref": "#/definitions/SemanticJudgeMode"
        }
      }
    },
    "JobShape": {
      "type": "string",
      "enum": [
        "single",
        "graph",
        "legacy_chain",
        "legacy_campaign"
      ]
    },
    "JobToolPolicy": {
      "type": "object",
      "required": [
        "workspace_read",
        "workspace_write"
      ],
      "properties": {
        "network_allowlist": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workspace_read": {
          "type": "boolean"
        },
        "workspace_write": {
          "type": "boolean"
        }
      }
    },
    "SemanticJudgeMode": {
      "type": "string",
      "enum": [
        "required",
        "optional",
        "disabled"
      ]
    }
  }
}
